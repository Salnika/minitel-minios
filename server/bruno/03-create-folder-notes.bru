meta {
  name: Create folder notes
  type: http
  seq: 3
}

post {
  url: {{bibliotekBaseUrl}}/folders
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{bibliotekApiToken}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "name": "{{bibliotekFolder}}"
  }
}
